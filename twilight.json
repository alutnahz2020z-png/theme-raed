            "labelHTML": "&lt;!-- حاوية الوسوم --&gt; <div id=\"show_tags\">   <a href=\"#\" class=\"tag\">#اليوم_التأسيس</a>   <a href=\"#\" class=\"tag\">#المملكة</a>   <a href=\"#\" class=\"tag\">#تراث</a>   <a href=\"#\" class=\"tag\">#تاريخ</a>   <a href=\"#\" class=\"tag\">#ثقافة</a> </div>  &lt;style&gt; /* حاوية الوسوم */ #show_tags {   display: flex;   flex-wrap: wrap;   gap: 12px;   justify-content: center;   margin: 20px 0;   animation: fadeIn 0.8s ease-in-out; }  /* كل وسم */ #show_tags .tag {   background: #F5E6C8; /* بيج تراثي */   color: #006C35;      /* أخضر تأسيس */   border: 1px solid #C9A635; /* ذهبي */   padding: 8px 16px;   border-radius: 30px;   font-size: 14px;   font-weight: bold;   text-decoration: none;   transition: all 0.3s ease;   cursor: pointer; }  /* التفاعل عند المرور */ #show_tags .tag:hover {   background: #006C35;   /* أخضر غامق */   color: #fff;           /* أبيض */   transform: translateY(-4px) scale(1.05);   box-shadow: 0 4px 10px rgba(0,0,0,0.2);   border-color: #004F27; /* أخضر أغمق */ }  /* حركة دخول */ @keyframes fadeIn {   from { opacity: 0; transform: translateY(10px); }   to { opacity: 1; transform: translateY(0); } } &lt;/style&gt;"
