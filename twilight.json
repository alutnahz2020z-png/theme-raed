            "label": "طريقة عرض الصور في سليدر صور المنتج",
            "description": null,
            "labelHTML": "&lt;!-- سلايدر صور المنتج --&gt; <div id=\"slider_background_size\">   <div class=\"slide active\">     <img src=\"https://via.placeholder.com/600x400.png?text=صورة+1\" alt=\"صورة المنتج 1\">   </div>   <div class=\"slide\">     <img src=\"https://via.placeholder.com/600x400.png?text=صورة+2\" alt=\"صورة المنتج 2\">   </div>   <div class=\"slide\">     <img src=\"https://via.placeholder.com/600x400.png?text=صورة+3\" alt=\"صورة المنتج 3\">   </div>    &lt;!-- أزرار التنقل --&gt;   &lt;button class=\"prev\"&gt;‹&lt;/button&gt;   &lt;button class=\"next\"&gt;›&lt;/button&gt; </div>  &lt;style&gt; /* الحاوية الرئيسية */ #slider_background_size {   position: relative;   width: 100%;   max-width: 600px;   margin: auto;   overflow: hidden;   border: 3px solid #006C35; /* إطار أخضر */   border-radius: 12px;   box-shadow: 0 6px 18px rgba(0,0,0,0.15);   background: #F5E6C8; /* بيج تراثي */ }  /* الشرائح */ #slider_background_size .slide {   display: none;   width: 100%;   animation: fade 1s ease-in-out; }  #slider_background_size .slide.active {   display: block; }  #slider_background_size img {   width: 100%;   display: block;   border-radius: 10px; }  /* أزرار التنقل */ #slider_background_size .prev, #slider_background_size .next {   position: absolute;   top: 50%;   transform: translateY(-50%);   background: #006C35;   color: #fff;   border: none;   padding: 10px 16px;   font-size: 24px;   font-weight: bold;   cursor: pointer;   border-radius: 50%;   transition: background 0.3s ease, transform 0.2s ease; }  #slider_background_size .prev:hover, #slider_background_size .next:hover {   background: #004F27;   transform: scale(1.1); }  #slider_background_size .prev {   left: 15px; }  #slider_background_size .next {   right: 15px; }  /* حركة التلاشي */ @keyframes fade {   from {opacity: 0.4}   to {opacity: 1} } &lt;/style&gt;   {     slide.classList.remove(\"active\");     if (i === index) slide.classList.add(\"active\");   }); }  prevBtn.addEventListener(\"click\", () => {   slideIndex = (slideIndex > 0) ? slideIndex - 1 : slides.length - 1;   showSlide(slideIndex); });  nextBtn.addEventListener(\"click\", () => {   slideIndex = (slideIndex &lt; slides.length - 1) ? slideIndex + 1 : 0;   showSlide(slideIndex); });  /* إظهار أول صورة */ showSlide(slideIndex); ",
